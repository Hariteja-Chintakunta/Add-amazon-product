# Product to search on amazon.in (required)
PRODUCT_NAME=wireless headphones

# Set to "false" to watch the browser (headed mode)
HEADLESS=true

# Selection criteria for the "best" product
MIN_RATING=4.0
MIN_REVIEWS=100

# How many search results to scan on page 1
MAX_RESULTS=20

# Amazon India base URL
BASE_URL=https://www.amazon.in

# Where logs, screenshots and JSON are saved
OUTPUT_DIR=test-results

# Optional: path to a Playwright storage-state file (auth.json) if you signed in manually once.
# Leave empty to run without sign-in; the framework stops gracefully if Amazon asks to sign in.
AUTH_STATE_PATH=
